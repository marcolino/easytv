
{
  "name": "easytv",
  "version": "1.0.0",
  "description": "Simple desktop TV streaming launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "TVSET=0 TMPDIR=\"$PWD/.tmp\" electron_config_cache=\"$PWD/.electron-cache\" electron --ozone-platform=x11 .",
    "start:tvset": "TVSET=1 TMPDIR=\"$PWD/.tmp\" electron_config_cache=\"$PWD/.electron-cache\" electron --ozone-platform=x11 .",
    "start:wayland": "TMPDIR=\"$PWD/.tmp\" electron_config_cache=\"$PWD/.electron-cache\" electron --ozone-platform=wayland .",

    "check": "node --check src/main.js && node --check src/preload.js && node --check src/preferences.js && node --check src/i18n.js && node --check src/renderer/app.js && node --check scripts/increment-build.js && node --check scripts/i18n-check.js && node --check scripts/i18n-translate.js && npm run i18n:check",

    "i18n": "npm run i18n:translate && npm run i18n:check",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:sync": "node scripts/i18n-check.js --sync",
    "i18n:translate": "npm run i18n:sync && node scripts/i18n-translate.js",

    "build": "npm run i18n && npm run check && npm run build:win && npm run build:linux && echo \"\\n\\nAll builds complete!\"",
    
    "prebuild:win": "node scripts/increment-build.js",
    "build:win": "electron-builder --win nsis --x64",

    "prebuild:linux": "node scripts/increment-build.js",
    "build:linux": "electron-builder --linux deb --x64",

    "prepack:linux": "node scripts/increment-build.js",
    "pack:linux": "electron-builder --linux --dir --x64",

    "vm": "virt-manager"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v46.0.0-alpha.7+wvcus",
    "electron-builder": "^26.18.1"
  },
  "author": "Marco Solari <marcosolari@gmail.com>",
  "homepage": "https://github.com/marcolino/easytv",
  "desktopName": "EasyTV"
}
