{
  "name": "easytv",
  "version": "1.0.0",
  "description": "Simple desktop TV streaming launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "TMPDIR=\"$PWD/.tmp\" electron_config_cache=\"$PWD/.electron-cache\" electron --ozone-platform=x11 .",
    "start:wayland": "TMPDIR=\"$PWD/.tmp\" electron_config_cache=\"$PWD/.electron-cache\" electron --ozone-platform=wayland .",

    "check": "node --check src/main.js && node --check src/preload.js && node --check src/channels.js && node --check src/renderer/app.js && node --check scripts/increment-build.js",

    "build": "npm run check && npm run build:win && npm run build:linux && echo \"\\n\\nAll builds complete!\"",

    "prebuild:win": "node scripts/increment-build.js",
    "build:win": "electron-builder --win nsis --x64",

    "prebuild:linux": "node scripts/increment-build.js",
    "build:linux": "electron-builder --linux deb --x64",

    "prepack:linux": "node scripts/increment-build.js",
    "pack:linux": "electron-builder --linux --dir --x64",

    "vm": "virt-manager"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v46.0.0-alpha.7+wvcus",
    "electron-builder": "^26.18.1"
  },
  "author": "Marco Solari <marcosolari@gmail.com>",
  "homepage": "https://github.com/marcolino/easytv",
  "desktopName": "EasyTV"
}
